{
  "name": "myoffice-one-2026",
  "productName": "MyOffice One",
  "version": "0.4.1",
  "description": "Free offline office suite for Windows: edit documents, spreadsheets and presentations with DOCX, XLSX and PPTX support",
  "author": "MyOffice One project",
  "private": true,
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "package-win": "electron-packager . MyOfficeOne --platform=win32 --arch=x64 --out=dist-portable --overwrite --prune=true --icon=assets/myoffice-icon.ico --ignore=smoke-test --ignore=README --ignore=.github --ignore=dist-installer --ignore=dist-portable",
    "installer-win": "electron-builder --win nsis --x64 --publish never",
    "test": "node --check main.js && node --check preload.js && node smoke-test.mjs && node test-launch.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.myofficeone.desktop",
    "productName": "MyOffice One",
    "asar": true,
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "assets/**/*",
      "package.json",
      "LICENSE.txt"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/myoffice-icon.ico",
      "fileAssociations": [
        {
          "ext": "docx",
          "name": "MyOffice One Document",
          "description": "Word-compatible document",
          "role": "Editor",
          "icon": "assets/myoffice-icon.ico"
        },
        {
          "ext": "xlsx",
          "name": "MyOffice One Workbook",
          "description": "Excel-compatible workbook",
          "role": "Editor",
          "icon": "assets/myoffice-icon.ico"
        },
        {
          "ext": "pptx",
          "name": "MyOffice One Presentation",
          "description": "PowerPoint-compatible presentation",
          "role": "Editor",
          "icon": "assets/myoffice-icon.ico"
        },
        {
          "ext": "myoffice",
          "name": "MyOffice One Project",
          "description": "MyOffice editable backup",
          "role": "Editor",
          "icon": "assets/myoffice-icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyOffice One",
      "artifactName": "MyOffice-One-Setup-${version}-${arch}.${ext}",
      "uninstallDisplayName": "MyOffice One"
    }
  },
  "homepage": "https://github.com/msaadatmustafa-tech/myoffice-one-2026#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/msaadatmustafa-tech/myoffice-one-2026.git"
  },
  "bugs": {
    "url": "https://github.com/msaadatmustafa-tech/myoffice-one-2026/issues"
  },
  "keywords": [
    "office-suite",
    "offline-editor",
    "windows",
    "document-editor",
    "spreadsheet",
    "presentation",
    "docx",
    "xlsx",
    "pptx",
    "free-software"
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.9"
  }
}
